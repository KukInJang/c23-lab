{
  "name": "C 프로그래밍 대회 · C23",
  "image": "mcr.microsoft.com/devcontainers/cpp:debian13",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "C_Cpp.default.compilerPath": "/usr/bin/gcc",
        "C_Cpp.default.cStandard": "c23"
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "main.c"]
    }
  }
}
